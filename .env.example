# Root .env.example — copy to .env for production overrides

# Backend
DATABASE_URL=sqlite+aiosqlite:///./learnpath.db
JWT_SECRET=change-this-to-a-random-secret-in-production
AI_PROVIDER=demo
AI_API_KEY=
DEMO_MODE=true
FRONTEND_URL=http://localhost:3000
DEBUG=false

# To use Gemini: set AI_PROVIDER=gemini and AI_API_KEY=your-gemini-key
# To use Groq:   set AI_PROVIDER=groq   and AI_API_KEY=your-groq-key
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
