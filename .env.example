# Skillora AI — Backend & Local Environment Configuration
# Copy this file to .env or backend/.env and populate with your production credentials

# AI Configuration
# Options: 'groq', 'demo'
AI_PROVIDER=groq
# Your Groq API key (never commit real keys to GitHub)
AI_API_KEY=your_groq_api_key_here
DEMO_MODE=false

# Security & Auth
JWT_SECRET=generate-a-secure-random-secret-key-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default (SQLite): sqlite+aiosqlite:///./learnpath.db
# PostgreSQL / Supabase: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./learnpath.db

# CORS Configuration
FRONTEND_URL=http://localhost:3000
